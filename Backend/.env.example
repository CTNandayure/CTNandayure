DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctnandayure?schema=public"

PORT=3000

# JWT Configuration
JWT_SECRET="your-jwt-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="24h"

# Token Expiration Configuration
ACTIVATION_TOKEN_EXPIRES_IN="24h"
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"

# Gmail Configuration
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="noreply@ctnandayure.com"

# Frontend URL for email links
FRONTEND_URL="http://localhost:5173"

