generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InstitutionalInfo {
  id              Int      @id @default(autoincrement())
  aboutTitle      String
  aboutText       String
  historyText     String
  missionText     String
  visionText      String
  aboutImageUrl   String?
  contactImageUrl String?
  heroImageUrl    String?
  address         String
  phone           String
  email           String
  officeHours     String
  updatedAt       DateTime @updatedAt

  @@map("institutional_info")
}

enum NewsStatus {
  BORRADOR
  PUBLICADO
}

model News {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  content     String
  imageUrl    String?
  status      NewsStatus @default(BORRADOR)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("news")
}

// Enums for User role
enum Role {
  ADMIN
  NEGOCIO
}

// Enums for User account status
enum UserStatus {
  PENDIENTE_ACTIVACION
  ACTIVO
  INACTIVO
}

// Person entity - Stores personal information
model Person {
  id_person String @id @default(cuid())
  name      String   @db.VarChar(50)
  first_lastname String   @db.VarChar(50)
  second_lastname String   @db.VarChar(50)
  phone     String   @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User?
}

// User entity - Represents a user account
model User {
  id_person String      @id @default(cuid())
  email     String      @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  role        Role        @default(NEGOCIO)
  status      UserStatus  @default(PENDIENTE_ACTIVACION)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  personId  String      @unique
  person    Person      @relation(fields: [personId], references: [id_person], onDelete: Cascade)

  activationTokens     ActivationToken[]
  passwordResetTokens  PasswordResetToken[]
  business             Business?
}

// ActivationToken entity - For account activation flow
model ActivationToken {
  id String @id @default(cuid())
  tokenHash String @db.VarChar(255) @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id_person], onDelete: Cascade)
}

// PasswordResetToken entity - For password recovery flow
model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @db.VarChar(255) @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id_person], onDelete: Cascade)
}

// Business request/application status
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Business visibility status
enum BusinessStatus {
  ACTIVE
  INACTIVE
}

// Business category
enum BusinessCategory {
  LODGING        // Hospedaje
  FOOD           // Alimentación
  TRANSPORT      // Transporte
  CRAFTS         // Artesanías
  TOURS          // Tours
  AGROTOURISM    // Agroturismo
  COMMERCE       // Comercio
}

// District enum
enum District {
  CARMONA
  SANTA_RITA
  ZAPOTAL
  SAN_PABLO
  PORVENIR
  BEJUCO
}

// Business affiliation request
model BusinessRequest {
  id              String          @id @default(cuid())

  businessName    String          @db.VarChar(150)
  categories      BusinessCategory[]
  district        District
  description     String          @db.VarChar(2000)

  phone           String          @db.VarChar(20)   // Business phone
  email           String          @db.VarChar(100)
  address         String          @db.VarChar(500)
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  facebookUrl     String?         @db.VarChar(255)
  instagramUrl    String?         @db.VarChar(255)
  scheduleText    String          @db.VarChar(500)

  coverImageUrl   String          @db.VarChar(500)
  galleryUrls     String[]

  documentUrls    String[]

  applicantName           String  @db.VarChar(50)
  applicantFirstLastname  String  @db.VarChar(100)
  applicantSecondLastname String  @db.VarChar(100)
  applicantPhone          String  @db.VarChar(20)   // Personal phone
  applicantEmail          String  @db.VarChar(100)

  requestStatus   RequestStatus   @default(PENDING)
  rejectionReason String?         @db.VarChar(1000)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business        Business?

  @@map("business_requests")
}

// Affiliated business
model Business {
  id              String          @id @default(cuid())
  slug            String?         @unique @db.VarChar(160)

  businessName    String          @db.VarChar(150)
  categories      BusinessCategory[]
  district        District
  description     String          @db.VarChar(2000)

  phone           String          @db.VarChar(20)
  email           String          @db.VarChar(100)
  address         String          @db.VarChar(500)
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  facebookUrl     String?         @db.VarChar(255)
  instagramUrl    String?         @db.VarChar(255)
  scheduleText    String          @db.VarChar(500)

  coverImageUrl   String          @db.VarChar(500)
  galleryUrls     String[]
  documentUrls    String[]

  businessStatus  BusinessStatus  @default(ACTIVE)

  requestId       String?         @unique
  request         BusinessRequest? @relation(fields: [requestId], references: [id])

  userId          String?         @unique
  user            User?           @relation(fields: [userId], references: [id_person])

  activities      Activity[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("businesses")
}

// Activity category (OTHER lets the business write its own label)
enum ActivityCategory {
  SURF           // Surf
  HIKING         // Senderismo
  CULTURE        // Cultura
  AGROTOURISM    // Agroturismo
  GASTRONOMY     // Gastronomía
  WILDLIFE       // Avistamiento de fauna
  OTHER          // Otra (se escribe en customCategory)
}

// How an activity is scheduled
enum ActivityScheduleType {
  SPECIFIC_DATE  // Un día específico
  RECURRING      // Se repite por días de la semana
}

// Publication lifecycle. INACTIVA is set by an admin (moderation): the owner
// cannot publish it again until an admin reactivates it.
enum ActivityStatus {
  BORRADOR
  PUBLICADA
  INACTIVA
}

// Tourist activity offered by an affiliated business
model Activity {
  id               String               @id @default(cuid())
  slug             String               @unique

  name             String               @db.VarChar(150)
  description      String               @db.VarChar(2000)
  category         ActivityCategory
  customCategory   String?              @db.VarChar(60)
  durationMinutes  Int
  requirements     String?              @db.VarChar(1000)

  // SPECIFIC_DATE: startDate is the day. RECURRING: daysOfWeek (ISO 1=Mon..7=Sun)
  // plus an optional validity window [startDate, endDate]. Dates are plain DATEs
  // and startTime is "HH:mm" so there is no time-zone drift (Costa Rica, UTC-6).
  scheduleType     ActivityScheduleType
  startDate        DateTime?            @db.Date
  endDate          DateTime?            @db.Date
  daysOfWeek       Int[]
  startTime        String               @db.VarChar(5)

  meetingPoint     String               @db.VarChar(500)
  meetingLatitude  Float?
  meetingLongitude Float?

  imageUrl         String?              @db.VarChar(500)

  status           ActivityStatus       @default(BORRADOR)
  publishedAt      DateTime?

  businessId       String
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([businessId])
  @@index([status])
  @@map("activities")
}
